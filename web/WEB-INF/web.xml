<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
<!--    web配置文件-->
<!--    中央控制器，所有请求进行转发-->
<!--
    1,处理所有的用户的请求，servlet配置进去.
    -->
    <servlet>
        <servlet-name>springDispatcherServlet</servlet-name>
        <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>

<!--        配置属性
    指定 这个 dispatcher 操作的spring文件。
-->
<!--        <init-param>-->
<!--            <param-name>contextConfigLocation</param-name>-->
<!--            <param-value>classpath:WEB-INF/springDispatcherServlet-servlet.xml</param-value>-->
<!--        </init-param>-->

<!--        web启动时候，自动加载DispatcherServlet-->
        <load-on-startup>1</load-on-startup>

    </servlet>

<!--   servlet mapping  上面没有这个会爆红
    1,url : / , 表示用户的请求都经过 DispatcherServlet
    2, 也是rest url 的风格。

-->
    <servlet-mapping>
        <servlet-name>springDispatcherServlet</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

</web-app>